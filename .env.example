# Local: leave empty (SQLite at data/helix.db) or set file:data/helix.db
# Vercel: Neon connection string, postgres:// or postgresql://
DATABASE_URL=

# Required on Vercel. Any long random string.
#   openssl rand -base64 32
SESSION_SECRET=dev-only-change-me

# Optional. Public origin used for OAuth redirect URIs.
# Local default: http://localhost:5173
# Vercel default: https://helix-green-one.vercel.app
APP_ORIGIN=

# Google OAuth 2.0 (GCP). Redirect URI must be:
#   {APP_ORIGIN}/api/auth/google/callback
# Production: https://helix-green-one.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X OAuth 2.0. Redirect URI must be:
#   {APP_ORIGIN}/api/auth/x/callback
# Production: https://helix-green-one.vercel.app/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# WebAuthn RP ID. Sticky; changing it invalidates passkeys.
# Local default: localhost
# Vercel default: helix-green-one.vercel.app
WEBAUTHN_RP_ID=
